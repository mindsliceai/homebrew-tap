{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "mindslice agent-hook start",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "mindslice agent-hook stop",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  }
}
